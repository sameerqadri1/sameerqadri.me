# Required: API base URL for case studies, contact form, and admin.
# - Local: http://localhost:3001 (when running API with npm run dev from apps/api)
# - Production: your deployed API URL (e.g. https://your-api.vercel.app)
# Changing this requires a rebuild for the client bundle to pick it up.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google reCAPTCHA v2 Invisible (site key is public)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcYI34sAAAAAJvn27Uv1CwpfhzP7XsYyygbU-u3

# Disable Next.js anonymous telemetry (optional)
NEXT_TELEMETRY_DISABLED=1
