// Neon (PostgreSQL) for production; use same or local Postgres for dev.
// Prisma 7: url is in prisma.config.ts; client uses @prisma/adapter-pg at runtime.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CaseStudy {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  subtitle      String?
  summary       String
  body          String
  coverImageUrl String?
  galleryUrls   String[] @default([])
  tags          String[] @default([])
  client        String?
  year          Int?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, order])
  @@index([slug])
}
